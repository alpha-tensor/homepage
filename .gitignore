# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.next
*.local

# Wrangler local state and dry-run output
.wrangler
.wrangler-dry-run

# Cloudflare credentials used by scripts/deploy.sh. Real values must never be
# committed, and an untracked file blocks a release, so .env has to stay
# ignored for the documented credential path to work at all.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated marketing thumbnails. The source of truth is data/exports/form-thumbnails in the
# root repo, copied here by make publish-form-thumbnails. Regenerable output, so it is not
# tracked and it must not block a release.
public/forms
